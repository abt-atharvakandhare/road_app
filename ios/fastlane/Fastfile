# Mirror of the Android lane hardening: `flutter clean` wipes build/ and
# .dart_tool/ so Xcode cannot package a stale App.framework (compiled Dart AOT)
# left in build/ios by a previous build of another branch. `flutter build ipa`
# then compiles fresh from the current source and regenerates the plugin registrant.
def flutter_build_ipa(flavor:, export_method: nil)
  sh("flutter", "clean")
  args = ["flutter", "build", "ipa", "--flavor=#{flavor}"]
  args << "--export-method=#{export_method}" if export_method
  sh(*args)
end

# Maps known failure signatures to the next step that actually fixes them,
# shown alongside the raw error in the end-of-run summary.
def failure_hint(error)
  case error
  when /Program License Agreement|PLA Update/i
    "The team's Account Holder (named in the error) must log in at developer.apple.com → Membership and accept the new agreement. Nothing to fix locally."
  when /membership.*(expired|on hold)|renew your (Apple Developer|membership)/i
    "The Apple Developer membership for this team has lapsed — renew it at developer.apple.com → Membership."
  when /Invalid username and password|Your session has expired|Two-(factor|step).*(required|expired)/i
    "Apple session is stale — run `bundle exec fastlane spaceauth -u r@ymon.do` and re-run the lane."
  when /firebase|invalid_grant|refresh token/i
    "Firebase CLI auth problem — run `firebase login --reauth` and re-run the lane."
  when /Exit status of command 'flutter/i
    "The Flutter build itself failed — scroll up to this app's `flutter build ipa` output for the real error."
  end
end

# Runs each app's release lane in turn, catching failures (commonly an
# out-of-date Apple account/session in get_certificates) so one broken app
# does not stop the remaining apps. Prints a per-app status summary at the
# end and only then fails the lane if any app failed.
def run_lanes_with_summary(lanes)
  results = {}
  lanes.each do |name, release_lane|
    begin
      release_lane.call
      results[name] = nil
    rescue => e
      UI.error("#{name} failed: #{e.message}")
      results[name] = e.message.to_s.gsub(/\s+/, " ").strip[0, 400]
    end
  end

  UI.header("Release status")
  results.each do |name, error|
    if error
      UI.error("❌ #{name} — #{error}")
      hint = failure_hint(error)
      UI.important("   ↳ Next step: #{hint}") if hint
    else
      UI.success("✅ #{name}")
    end
  end

  failed = results.select { |_, error| error }.keys
  UI.user_error!("Failed releases: #{failed.join(', ')}") unless failed.empty?
end

