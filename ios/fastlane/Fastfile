  desc "Build all apps - Release to App Store"
  lane :releaseAppStoreAll do

    releaseEFluxAppStore
    releaseFriwigoAppStore
    # releaseVcityAppStore
    # releaseEzdrivePlusAppStore
    # releaseNxt50fiveAppStore
    # releaseVcityReunionAppStore
    # releaseNxtMobilityAppStore
    # releaseMyComolyAppStore
    # releaseMaesEvAppStore
    # releaseKiaChargeNlAppStore
  end
end
