<?xml version="1.0" encoding="utf-8"?>
<!-- Gradient fill (yellow→green) used for the charging progress bar. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="2dp" />
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#D5DE4C"
        android:endColor="#00F10A" />
</shape>
