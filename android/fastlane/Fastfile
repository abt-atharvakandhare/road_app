platform :android do

  desc "E-Flux - Deploy a new version to the Google Play"
  lane :releaseGooglePlayEFlux do
    puts "E-Flux Releasing to Google Play Store"
    puts "-----------------------"
    puts "Version: #{version_number}"
    puts "Build: #{build_number}"
    puts "-----------------------"

    flutter_build_app(project_root: flutter_project_root, flavor: "eflux", output: "apk", version_name: version_number, version_code: build_number)

    gradle(task: "assemble",
    flavor: "eflux",
    build_type: "Release",
    print_command: true,
    properties: {
      "android.injected.signing.store.file" => "#{flutter_project_root}/android/fastlane/eflux-ev-keystore.jks",
      "android.injected.signing.store.password" => "948b7e5ddb7444d0b404f96e0103cad4",
      "android.injected.signing.key.alias" => "QGthYXJlYWwvRS1GbHV4LUVW",
      "android.injected.signing.key.password" => "bc26406f2dd5401885d4044a532a1b6a",
      "android.injected.version.name" => version_number,
      "android.injected.version.code" => build_number
    })

    upload_to_play_store(
      apk: "../build/app/outputs/apk/eflux/release/app-eflux-release.apk",
      changes_not_sent_for_review: true,
      rollout: "1"
    )
  end

