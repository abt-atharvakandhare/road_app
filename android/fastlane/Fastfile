# Gradle's assemble/bundle tasks compile the Dart AOT but do not regenerate
# GeneratedPluginRegistrant.java or run pub get, so a stale registrant (e.g. left
# behind by a patrol test run) survives into the release artifact. `flutter clean`
# also wipes build/ and .dart_tool/, so Gradle's native-lib merge/strip caches
# cannot reuse a stale libapp.so from a previous build of another branch. Running
# this before the Gradle step guarantees the packaged build is compiled fresh from
# the current source. The Gradle step still owns the signed output that is uploaded.
def flutter_build_app(project_root:, flavor:, output:, version_name:, version_code:)
  sh("cd #{project_root} && flutter clean && flutter build #{output} --flavor #{flavor} --release --build-name=#{version_name} --build-number=#{version_code}")
end

# Maps known failure signatures to the next step that actually fixes them,
# shown alongside the raw error in the end-of-run summary.
def failure_hint(error)
  case error
  when /firebase|invalid_grant|refresh token/i
    "Firebase CLI auth problem — run `firebase login --reauth` and re-run the lane."
  when /The caller does not have permission|androidpublisher|Google Api Error/i
    "Play Console API rejected the upload — check the service account / API access permissions for this app."
  when /keystore|signing/i
    "Signing failed — check the keystore path and credentials in this app's lane."
  when /Exit status of command|Gradle build failed/i
    "The build itself failed — scroll up to this app's flutter/gradle output for the real error."
  end
end

# Runs each app's release lane in turn, catching failures so one broken app
# does not stop the remaining apps. Prints a per-app status summary at the
# end and only then fails the lane if any app failed.
def run_lanes_with_summary(lanes)
  results = {}
  lanes.each do |name, release_lane|
    begin
      release_lane.call
      results[name] = nil
    rescue => e
      UI.error("#{name} failed: #{e.message}")
      results[name] = e.message.to_s.gsub(/\s+/, " ").strip[0, 400]
    end
  end

  UI.header("Release status")
  results.each do |name, error|
    if error
      UI.error("❌ #{name} — #{error}")
      hint = failure_hint(error)
      UI.important("   ↳ Next step: #{hint}") if hint
    else
      UI.success("✅ #{name}")
    end
  end

  failed = results.select { |_, error| error }.keys
  UI.user_error!("Failed releases: #{failed.join(', ')}") unless failed.empty?
end

